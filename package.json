{
  "name": "autologika-os",
  "version": "1.0.12",
  "private": true,
  "description": "Autologika OS - system operacyjny warsztatu samochodowego",
  "author": "Autologika",
  "main": "electron/main.cjs",
  "scripts": {
    "test": "node --test tests/*.test.cjs && node --experimental-default-type=module --test tests/*.test.mjs",
    "test:catalog": "node --experimental-default-type=module scripts/audit-work-catalog.mjs",
    "test:migration": "node scripts/run-electron-smoke.cjs",
    "test:ui": "npm run build && node scripts/run-electron-smoke.cjs ui-preview.cjs",
    "test:protocol": "node scripts/run-electron-smoke.cjs protocol-preview.cjs",
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "vite build",
    "start": "electron .",
    "postinstall": "electron-builder install-app-deps",
    "dist": "npm run build && electron-builder --win nsis --publish never --config.win.signAndEditExecutable=false",
    "dist:win": "npm run dist",
    "dist:portable": "npm run build && electron-builder --win portable --config.win.signAndEditExecutable=false",
    "release": "npm test && npm run build && electron-builder --win nsis --publish always",
    "rebuild": "electron-rebuild -f -w better-sqlite3"
  },
  "dependencies": {
    "better-sqlite3": "^11.7.0",
    "electron-updater": "^6.8.9",
    "polish-vehicle-registration-certificate-decoder": "^1.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8",
    "vite": "^6.0.5",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "pl.autologika.os",
    "productName": "Autologika OS",
    "generateUpdatesFilesForAllChannels": true,
    "directories": {
      "output": "release"
    },
    "artifactName": "Autologika-Setup-${version}.${ext}",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "documents/**/*"
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "win": {
      "icon": "build/icon.png",
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Autologika OS",
      "uninstallDisplayName": "Autologika OS"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "endiszyd-rgb",
        "repo": "Autologika-OS",
        "releaseType": "release"
      }
    ]
  }
}
